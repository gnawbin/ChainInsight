# Copy to `.env` (or `.env.local`) and adjust.
# All values are exposed to the frontend bundle (Vite `VITE_` prefix) — never put secrets here.

# Which cluster the app boots into.
# One of: devnet | local
# `local` expects a validator or Surfpool on VITE_SOLANA_RPC_URL.
VITE_SOLANA_CLUSTER=devnet

# Optional overrides. When omitted the @solana/kit-plugin-rpc bundle defaults apply:
#   devnet -> https://api.devnet.solana.com        (wss://api.devnet.solana.com)
#   local  -> http://127.0.0.1:8899                (ws://127.0.0.1:8900)
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# VITE_SOLANA_WS_URL=wss://api.devnet.solana.com
